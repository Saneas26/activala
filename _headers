# Cabeceras que añade Cloudflare Pages a todas las respuestas.
# La web no carga nada de terceros ni pone cookies, así que la política
# puede ser estricta sin romper nada. Si algún día se añade un script
# externo, hay que ampliar la CSP o dejará de cargar EN SILENCIO.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://uikanfvigunjhzibnhxf.supabase.co https://pordondevoy-saneas.vercel.app; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Los .woff2 llevan hash de contenido en el nombre? No: se cachean un año
# porque solo cambian si se sustituye el fichero entero.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=2592000
